# --- Database (required) ------------------------------------------------------
# On Railway this is a reference variable: ${{Postgres.DATABASE_URL}}
# Locally: run `npm run db:local` and use the URL it prints.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54330/rivalry_dev

# --- Screenshot storage (required in production) ------------------------------
# Directory on a persistent Railway Volume. Defaults to ./.data/screenshots.
STORAGE_DIR=/data/screenshots

# --- Login (required) -----------------------------------------------------------
# Numeric room code (4-12 digits). Both players enter it, then pick who they are.
# Changing it signs every device out.
APP_PIN=
# Optional starting names for the two seats (renameable in the Room page).
# PLAYER_A_NAME=
# PLAYER_B_NAME=

# --- AI screenshot extraction (optional; manual entry works without it) ------
# OpenRouter (default). Benchmarked: gemini-3.5-flash-lite read 30/30 fields
# in ~1.6 s for ~$0.0015 per screenshot; the fallback is used if it errors.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.5-flash-lite
OPENROUTER_FALLBACK_MODEL=google/gemini-3.8-flash
# Alternatives:
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Integration tests only ---------------------------------------------------
# TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54330/rivalry_test
